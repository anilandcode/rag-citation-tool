OPENAI_API_KEY=sk-...
COHERE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-citation
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Cheaper defaults for hosted demo
LLM_MODEL=gpt-4o-mini
LLM_EVAL_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=rerank-english-v3.0
RERANK_TOP_N=5
RETRIEVAL_TOP_K=20

# Frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://rag-citation-tool.vercel.app

# Leave API_KEY empty for open ingest in local dev; set in production dashboard
API_KEY=
# Public demo key used by /demo and /query
DEMO_API_KEY=demo-public-key

# Seed data/demo on boot
DEMO_AUTO_SEED=true
# Allow running without Cohere (hybrid only)
ALLOW_NO_RERANK=true
